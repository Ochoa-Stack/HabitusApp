    <TextView android:id="@+id/tvEmptyState" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/no_archivados" android:fontFamily="@font/dm_sans" android:textSize="15sp" android:textColor="@color/text_secondary" android:gravity="center" android:visibility="gone" android:layout_marginHorizontal="48dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>