<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">

    
    <View android:id="@+id/circleTop" android:layout_width="220dp" android:layout_height="220dp" android:background="@drawable/circle_accent_top" android:alpha="0.18" android:layout_marginTop="-60dp" android:layout_marginEnd="-60dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    
    <ImageView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arrow_back" android:padding="12dp" app:tint="@color/text_primary" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="Regresar" android:layout_marginStart="16dp" android:layout_marginTop="48dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    
    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/privacy_title" android:fontFamily="@font/playfair_display_bold" android:textSize="28sp" android:letterSpacing="-0.02" android:textColor="@color/text_primary" android:layout_marginStart="24dp" android:layout_marginTop="16dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/btnBack" />

    
    <TextView android:id="@+id/tvLastUpdate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/privacy_last_update" android:fontFamily="@font/dm_sans" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginStart="24dp" android:layout_marginTop="4dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    
    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:overScrollMode="never" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/tvLastUpdate" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="48dp">

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_background">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp">

                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/privacy_term_1_title" android:fontFamily="@font/playfair_display_semibold" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginBottom="8dp" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy_term_1_body" android:fontFamily="@font/dm_sans" android:textSize="14sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary" android:layout_marginBottom="20dp" />

                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/privacy_term_2_title" android:fontFamily="@font/playfair_display_semibold" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginBottom="8dp" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy_term_2_body" android:fontFamily="@font/dm_sans" android:textSize="14sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary" android:layout_marginBottom="20dp" />

                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/privacy_term_3_title" android:fontFamily="@font/playfair_display_semibold" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginBottom="8dp" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy_term_3_body" android:fontFamily="@font/dm_sans" android:textSize="14sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary" android:layout_marginBottom="20dp" />

                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/privacy_term_4_title" android:fontFamily="@font/playfair_display_semibold" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginBottom="8dp" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy_term_4_body" android:fontFamily="@font/dm_sans" android:textSize="14sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary" android:layout_marginBottom="20dp" />

                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/privacy_term_5_title" android:fontFamily="@font/playfair_display_semibold" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginBottom="8dp" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy_term_5_body" android:fontFamily="@font/dm_sans" android:textSize="14sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>