<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:ns2="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">

    <View android:id="@+id/circleTop" android:layout_width="220dp" android:layout_height="220dp" android:background="@drawable/circle_accent_top" android:alpha="0.18" android:layout_marginTop="-60dp" android:layout_marginEnd="-60dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <View android:id="@+id/circleBottom" android:layout_width="160dp" android:layout_height="160dp" android:background="@drawable/circle_accent_bottom" android:alpha="0.12" android:layout_marginBottom="-40dp" android:layout_marginStart="-40dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <ImageView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arrow_back" android:padding="12dp" app:tint="@color/text_primary" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="Regresar" android:layout_marginStart="16dp" android:layout_marginTop="48dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressBarSemanal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:tint="@color/accent"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView android:id="@+id/scrollViewContenido" android:layout_width="0dp" android:layout_height="0dp" android:overScrollMode="never" android:layout_marginTop="8dp" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/btnBack" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="48dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/weekly_title" android:fontFamily="@font/playfair_display_bold" android:textSize="28sp" android:letterSpacing="-0.02" android:textColor="@color/text_primary" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" />

            
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_background">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:gravity="center">

                    <TextView android:id="@+id/tvPorcentajeSemana" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/playfair_display_bold" android:textSize="72sp" android:textColor="@color/accent" ns2:text="80%" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/weekly_label_completion" android:fontFamily="@font/dm_sans_medium" android:textSize="13sp" android:textAllCaps="true" android:letterSpacing="0.08" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />

                    <TextView android:id="@+id/tvCompletacionesDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/dm_sans" android:textSize="14sp" android:textColor="@color/text_hint" android:layout_marginTop="8dp" ns2:text="8 de 10 días programados" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_background">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/weekly_label_best_streak" android:fontFamily="@font/dm_sans_medium" android:textSize="12sp" android:textAllCaps="true" android:letterSpacing="0.08" android:textColor="@color/text_secondary" />

                            <TextView android:id="@+id/tvHabitoMejorRacha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/dm_sans_medium" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="2dp" ns2:text="Meditar" />
                        </LinearLayout>

                        <TextView android:id="@+id/tvRachaMaxima" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/playfair_display_bold" android:textSize="40sp" android:textColor="@color/accent" ns2:text="12" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_color" android:layout_marginBottom="16dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/weekly_label_needs_attention" android:fontFamily="@font/dm_sans_medium" android:textSize="12sp" android:textAllCaps="true" android:letterSpacing="0.08" android:textColor="@color/text_secondary" android:layout_marginBottom="4dp" />

                    <TextView android:id="@+id/tvHabitoDescuidado" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/dm_sans_medium" android:textSize="15sp" android:textColor="@color/text_primary" ns2:text="Ejercicio" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/accent_light">

                <TextView android:id="@+id/tvMensajeSemanal" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:fontFamily="@font/playfair_display_semibold" android:textSize="18sp" android:lineSpacingExtra="4dp" android:textColor="@color/accent" ns2:text="Un esfuerzo más y terminas fuerte." />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>