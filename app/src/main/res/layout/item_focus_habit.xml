<?xml version='1.0' encoding='utf-8'?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">

        
        <View android:id="@+id/viewTipoColor" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_day_completed" android:layout_marginEnd="14dp" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

            <TextView android:id="@+id/tvFocusNombre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/playfair_display_semibold" android:textSize="15sp" android:textColor="@color/text_primary" />

            <TextView android:id="@+id/tvFocusTipo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/dm_sans" android:textSize="12sp" android:textColor="@color/text_hint" />

        </LinearLayout>

        
        <ImageView android:id="@+id/btnFocusCompletar" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_check_circle" app:tint="@color/divider_color" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="Completar" android:padding="12dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>