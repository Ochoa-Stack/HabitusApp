<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.habittrackerapp"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Se define el permiso para notificación en dispositivos con Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Definimos 'Habitus' como nombre de la aplicación -->
    <application
        android:name=".HabitusApp"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HabitTrackerApp">

        <!-- Definimos 'Splash' como punto de entrada -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Definimos 'Onboarding' para Usuarios primerizos -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Login' -->
        <activity
            android:name=".ui.InicioSesionInterfaz"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Registro' -->
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla de 'Modo Enfoque' -->
        <activity
            android:name=".ui.FocusModeActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Recuperación de contraseña' -->
        <activity
            android:name=".ui.ForgotPasswordActivity"
            android:exported="false"/>

        <!-- Definimos el contenedor principal con fragments y BottomNav -->
        <activity
            android:name=".MainActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Crear nuevo hábito' -->
        <activity
            android:name=".ui.CreateHabitActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Detalle de hábito' -->
        <activity
            android:name=".ui.HabitDetailActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Notificaciones' -->
        <activity
            android:name=".ui.NotificationsActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Apariencia' -->
        <activity
            android:name=".ui.AppearanceActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Privacidad' -->
        <activity
            android:name=".ui.PrivacyActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Acerca de' -->
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Crear nueva categoría' -->
        <activity
        android:name=".ui.CreateCategoryActivity"
        android:exported="false" />

        <!-- Definimos la pantalla 'Editar hábito' -->
        <activity
            android:name=".ui.EditHabitActivity"
            android:exported="false"/>


        <!-- Definimos la pantalla 'Hábitos archivados' -->
        <activity
            android:name=".ui.ArchivedHabitsActivity"
            android:exported="false"/>

        <!-- Definimos la pantalla 'Resumen semanal' -->
        <activity
            android:name=".ui.WeeklySummaryActivity"
            android:exported="false"/>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts"/>

    </application>

</manifest>
