rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y modificar su propio documento de perfil
    match /usuarios/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Los hábitos solo son accesibles por el usuario propietario (campo uid)
    match /habitos/{habitoId} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;

      // Las completaciones heredan la protección del hábito padre
      match /completaciones/{fechaId} {
        allow read, write: if request.auth != null
                           && request.auth.uid ==
                              get(/databases/$(database)/documents/habitos/$(habitoId)).data.uid;
      }

      match /reflexiones/{reflexionId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/habitos/$(habitoId)).data.uid
             == request.auth.uid;
      }
    }

    // Las categorías solo son accesibles por su propietario
    match /categorias/{categoriaId} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;
    }
  }
}
